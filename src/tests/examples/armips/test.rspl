  .align 2
.close

.create "test.imem", 0x1000
  vxor $v00, $v00, $v00  
  lpv $v31, 0($zero)
  vmudl $v30, $v31, $v31[7]
  
  LOOP:
    lw $t0, 0($zero)
    addiu $t0, $t0, 1
    sw $t0, 0($zero)
    j LOOP
